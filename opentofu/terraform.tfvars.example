# =============================================================================
# terraform.tfvars.example -- copy to <env>.tfvars and fill in per environment
# =============================================================================
# Secrets (do_token, ssh_public_key, spaces_*) should be supplied via
# environment variables / CI secrets rather than committed tfvars where possible:
#   export TF_VAR_do_token="$DIGITALOCEAN_TOKEN"
#   export TF_VAR_ssh_public_key="$DEPLOY_SSH_PUBKEY"
# =============================================================================

environment   = "nonprod" # nonprod | staging | prod
region        = "nyc3"
droplet_size  = "s-1vcpu-2gb"
droplet_image = "ubuntu-24-04-x64"
enable_backups = true

# Provide via TF_VAR_do_token in CI instead of committing:
# do_token = ""

# Provide via TF_VAR_ssh_public_key in CI instead of committing:
# ssh_public_key = "ssh-ed25519 AAAA... deploy@scalpbot"

# Lock down in staging/prod to your admin + CI egress ranges.
allowed_ssh_cidrs = ["0.0.0.0/0", "::/0"]

tags = []
