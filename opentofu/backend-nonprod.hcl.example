# =============================================================================
# backend-nonprod.hcl.example -- S3-compatible remote state backend config
# =============================================================================
# Copy to backend-nonprod.hcl and pass at init:
#   tofu init -backend-config=backend-nonprod.hcl
#
# Credentials come from env vars (never commit them):
#   export AWS_ACCESS_KEY_ID="$TFSTATE_S3_ACCESS_KEY"
#   export AWS_SECRET_ACCESS_KEY="$TFSTATE_S3_SECRET_KEY"
#
# State is stored in a DigitalOcean Spaces bucket (S3-compatible).
# Create the Spaces bucket + access keys in the DigitalOcean console, then set
# TFSTATE_S3_ACCESS_KEY / TFSTATE_S3_SECRET_KEY from the Spaces credentials.
# =============================================================================

bucket = "scalpbot-tfstate"
key    = "nonprod/terraform.tfstate"

# DigitalOcean Spaces (nyc3) endpoint:
endpoints = { s3 = "https://nyc3.digitaloceanspaces.com" }

region = "us-east-1" # dummy value required by the S3 backend for non-AWS stores

skip_credentials_validation = true
skip_metadata_api_check     = true
skip_region_validation      = true
skip_requesting_account_id  = true
use_path_style              = true
