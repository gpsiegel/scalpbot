# =============================================================================
# doppler.env.example  --  Doppler SECRET reference (scalpbot)
# =============================================================================
# Authoritative list of SECRETS managed in Doppler (per config: nonprod /
# staging / prod). This file is a reference only -- it contains NO real values.
#
# RULE: Only true secrets (API keys, credentials, DB password) and the
# ticker/coin lists belong in Doppler. NON-SECRET operational config (avenue
# toggles, position caps, market-hours flags, options filters, and the
# SENTIMENT_WEIGHT_* values) belongs in the plain .env file, NOT here.
# See python_space/.env.example for the operational config.
# =============================================================================


# -----------------------------------------------------------------------------
# Sentiment source credentials
# -----------------------------------------------------------------------------
# CoinGecko paid Basic tier API key  (REQUIRED -- added for the revised stack)
COINGECKO_API_KEY=

# LunarCrush free hobby tier API key  (already provisioned)
LUNARCRUSH_API_KEY=

# Reddit OAuth app credentials  (REQUIRED -- added for the revised stack)
#   REDDIT_USER_AGENT MUST follow Reddit's format, or requests get throttled:
#     platform:app_id:version (by /u/username)
#   e.g. python:scalpbot:1.0 (by /u/your_username)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# NOTE: cryptocurrency.cv and the Fear & Greed Index require NO key and are
# therefore NOT Doppler secrets.
# REMOVED (do not re-add): CRYPTOPANIC_API_KEY, TWITTER_*/X_* keys, NEWSAPI_KEY.


# -----------------------------------------------------------------------------
# Groq (AI sentiment / reasoning)
# -----------------------------------------------------------------------------
GROQ_API_KEY=

# -----------------------------------------------------------------------------
# Alpaca (trading + market data)
# -----------------------------------------------------------------------------
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=

# -----------------------------------------------------------------------------
# API auth
# -----------------------------------------------------------------------------
# Control-plane key required in the X-API-Key header on every state-changing
# endpoint of the local API (POST /run-cycle, /stocks/run-cycle,
# /options/run-cycle, /config, /mode, and GET /confirmation-token).
# The engine reads SCALPBOT_API_KEY first, then falls back to this API_KEY.
API_KEY=

# -----------------------------------------------------------------------------
# Infrastructure / deploy (DigitalOcean -- migrated from Linode)
# -----------------------------------------------------------------------------
# DigitalOcean API token used by OpenTofu + doctl (droplets, reserved IPs,
# firewalls, SSH keys). REPLACES the old LINODE_TOKEN.
DIGITALOCEAN_TOKEN=

# REMOVED with the DigitalOcean migration (do NOT re-add):
#   LINODE_TOKEN       -> replaced by DIGITALOCEAN_TOKEN
#   LINODE_ROOT_PASS   -> dropped; droplet uses SSH-key auth only
#
# The following are managed as GitHub Environment secrets (not Doppler), kept
# for reference: RESERVED_IPV4, DEPLOY_HOST, DEPLOY_SSH_PUBKEY, DEPLOY_SSH_KEY,
# DO_SSH_KEY_FINGERPRINT, TFSTATE_S3_ACCESS_KEY, TFSTATE_S3_SECRET_KEY,
# TF_ENCRYPTION.

# -----------------------------------------------------------------------------
# Ticker / coin lists (kept in Doppler)
# -----------------------------------------------------------------------------
# Comma-separated. Parsed by python_space/config.py (upper-cased, de-duped).
#
# STOCK_TICKERS  -- the equity/ETF universe. Known set:
#   STOCK_TICKERS=SCHD,XLF,XLE,GDX,SOFI,F,PLTR,HOOD
#
# CRYPTO_CORE_COINS      -- 8-coin core list (larger-cap, primary rotation)
# CRYPTO_SATELLITE_COINS -- 4-coin satellite list (higher-beta, opportunistic)
#   Every symbol MUST have a COIN_METADATA entry in sentiment/base.py. The
#   registry currently supports: BTC, ETH, SOL, DOGE, AVAX, LINK, LTC, DOT,
#   UNI, AAVE, BCH, SHIB, XRP, MKR, CRV, GRT, XTZ, SUSHI, YFI (all Alpaca-
#   tradeable USD markets). Add an entry there for any symbol not listed.
#   SOL and DOGE are confirmed part of the active trading set.
#   e.g. CRYPTO_CORE_COINS=BTC,ETH,SOL,DOGE,AVAX,LINK,LTC,DOT
#        CRYPTO_SATELLITE_COINS=SHIB,UNI,AAVE,BCH
STOCK_TICKERS=
CRYPTO_CORE_COINS=
CRYPTO_SATELLITE_COINS=
