# =============================================================================
# scalpbot .env.example
# =============================================================================
# This file documents PLAIN operational configuration. Copy to `.env` and edit.
#
# STANDING RULE FOR THIS PROJECT:
#   * Non-secret operational config (toggles, limits, WEIGHTS) lives HERE in the
#     plain .env file.
#   * Actual secrets (API keys, credentials, DB password) live in DOPPLER.
#     They are listed at the bottom as placeholders ONLY for local development;
#     in prod they are injected by Doppler, never committed.
# =============================================================================


# -----------------------------------------------------------------------------
# TRADING MODE  (NON-SECRET operational config)
# -----------------------------------------------------------------------------
# NOTE: The COMMITTED, PR-controlled source of operational config per
# environment is environments/<APP_ENV>.env (environments/nonprod.env and
# environments/prod.env). Those files are loaded as defaults at startup; a real
# environment variable (Doppler / CI / shell) always overrides them. This
# .env.example remains the reference for local development.
#
# Live trading requires ALL THREE: APP_ENV=prod AND PAPER_TRADING=false AND
# LIVE_TRADING=true. Any other APP_ENV value forces paper trading regardless:
#   * nonprod is ALWAYS paper -- no flag combination can make it live.
#   * prod is the ONLY live-capable environment, and still runs paper unless
#     all three guards above are set. Going live = a reviewable PR to prod.env.
APP_ENV=nonprod
PAPER_TRADING=true
LIVE_TRADING=false


# -----------------------------------------------------------------------------
# AVENUE TOGGLES  (NON-SECRET operational config)
# -----------------------------------------------------------------------------
# When an avenue is OFF it still MANAGES/EXITS existing positions but opens no
# new entries.
ENABLE_CRYPTO=true
ENABLE_STOCKS=true
ENABLE_OPTIONS=true

# Stocks/options only open new entries while the US equity market is open
# (uses Alpaca /v2/clock). Crypto is unaffected and trades 24/7.
RESPECT_MARKET_HOURS=true

# Allow short selling on stocks. Set false for stock long-only mode.
ALLOW_SHORT=true


# -----------------------------------------------------------------------------
# POSITION CAPS  (NON-SECRET operational config)
# -----------------------------------------------------------------------------
MAX_TOTAL_POSITIONS=3
MAX_CRYPTO_POSITIONS=2
MAX_STOCK_POSITIONS=2
MAX_OPTION_POSITIONS=2


# -----------------------------------------------------------------------------
# OPTIONS QUALITY FILTERS  (NON-SECRET operational config)
# -----------------------------------------------------------------------------
# Options are buy-to-open only (long calls/puts).
OPTION_MIN_DTE=7            # skip near-expiry / 0-DTE contracts
OPTION_MAX_DTE=45           # far bound of the contract query window
OPTION_MAX_OTM_PCT=0.10     # near-the-money only, no deep-OTM lottery tickets
OPTION_MIN_PREMIUM=0.10     # skip near-worthless contracts
OPTION_MAX_SPREAD_PCT=0.08  # skip illiquid, wide bid/ask contracts
# Management (not an entry filter): close a held option once it's this close
# to expiry, regardless of P&L -- Alpaca auto-exercises/force-sells ITM
# contracts near expiry.
OPTION_EXIT_DTE=2


# -----------------------------------------------------------------------------
# ENTRY / EXIT THRESHOLDS  (NON-SECRET operational config)
# -----------------------------------------------------------------------------
# Aggregated sentiment score is in [-1, 1]. Entry fires when it crosses these.
CRYPTO_ENTRY_SCORE=0.15     # open long crypto at/above this bullish score
STOCK_ENTRY_SCORE=0.15      # open long (or short, if ALLOW_SHORT) stock
OPTION_ENTRY_SCORE=0.25     # options need stronger conviction (call/put)
# Price-based exits for crypto/stock (fraction of entry price).
# LEGACY / SUPERSEDED: take-profit and stop-loss are now driven by the active
# RISK_TIER (see below). These two are retained only as the fallback used by
# engine.avenues when no tier thresholds are supplied. Leave commented out to
# let the risk tier own exit sizing.
# TAKE_PROFIT_PCT=0.03        # +3% take profit  (superseded by RISK_TIER)
# STOP_LOSS_PCT=0.02          # -2% stop loss    (superseded by RISK_TIER)
SENTIMENT_FLIP=0.0          # reversal-exit pivot around this score
# Notional budget allocated per new position (USD).
# NOTE: also superseded per-trade by the active RISK_TIER's position budget;
# kept as a global fallback.
POSITION_BUDGET_USD=100


# -----------------------------------------------------------------------------
# RISK TIER  (NON-SECRET operational config)
# -----------------------------------------------------------------------------
# Selects a coherent bundle of risk parameters (take-profit / stop-loss, entry
# conviction gate, Groq confidence floor, per-position budget, and option
# premium target). Resolved via engine.risk.get_tier(); an unknown value falls
# back to "moderate". One of: conservative | moderate | high.
#
#   conservative -> tight 2:1 R:R, strictest gate (score 0.25 / Groq 60%), $75
#   moderate     -> balanced default, 2:1 R:R (score 0.20 / Groq 55%), $100
#   high         -> momentum/runner, ~2.25-2.4:1 R:R (score 0.30 / Groq 60%), $150
RISK_TIER=moderate


# -----------------------------------------------------------------------------
# SENTIMENT SOURCE WEIGHTS  (NON-SECRET operational config)
# -----------------------------------------------------------------------------
# Weighted contribution of each sentiment source to the aggregated score.
# Unavailable sources are dropped and the remaining weights are renormalized,
# so these do not have to sum to exactly 1.0 -- but by default they do.
SENTIMENT_WEIGHT_REDDIT=0.30
SENTIMENT_WEIGHT_CRYPTOCV=0.25
SENTIMENT_WEIGHT_COINGECKO=0.20
SENTIMENT_WEIGHT_LUNARCRUSH=0.10
SENTIMENT_WEIGHT_TRENDS=0.08
SENTIMENT_WEIGHT_FEAR_GREED=0.07

# Minimum fraction of total positive source weight that must actually be
# available for a score to be trusted ("actionable"). Below this, the
# aggregator forces score=0.0 / label="insufficient_data" instead of letting
# one thin source (e.g. Fear & Greed alone) drive an entry/exit. See
# sentiment/README.md.
SENTIMENT_MIN_COVERAGE=0.5

# Per-source cache TTLs (seconds). Each source is hit twice per symbol per
# crypto cycle; without a cache, low-rate-limit APIs (Google Trends
# especially) get hammered.
SENTIMENT_TTL_FEAR_GREED=3600
SENTIMENT_TTL_TRENDS=3600
SENTIMENT_TTL_REDDIT=600
SENTIMENT_TTL_CRYPTOCV=600
SENTIMENT_TTL_LUNARCRUSH=900
SENTIMENT_TTL_COINGECKO=300


# -----------------------------------------------------------------------------
# SECRETS -- managed by DOPPLER in prod.
# -----------------------------------------------------------------------------
# The values below are PLACEHOLDERS for local development only. Do NOT commit
# real values. In deployed environments these come from Doppler, not this file.
# See doppler.env.example for the authoritative list of required Doppler secrets.

# CoinGecko paid Basic tier API key (used by the CoinGecko sentiment source).
COINGECKO_API_KEY=

# LunarCrush free hobby tier API key (galaxy score / alt rank market data).
LUNARCRUSH_API_KEY=

# Reddit OAuth app credentials.
# REDDIT_USER_AGENT MUST follow: platform:app_id:version (by /u/username)
# e.g. python:scalpbot:1.0 (by /u/your_username)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
