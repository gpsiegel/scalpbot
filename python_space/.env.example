# =============================================================================
# scalpbot .env.example
# =============================================================================
# This file documents PLAIN operational configuration. Copy to `.env` and edit.
#
# STANDING RULE FOR THIS PROJECT:
#   * Non-secret operational config (toggles, limits, WEIGHTS) lives HERE in the
#     plain .env file.
#   * Actual secrets (API keys, credentials, DB password) live in DOPPLER.
#     They are listed at the bottom as placeholders ONLY for local development;
#     in staging/prod they are injected by Doppler, never committed.
# =============================================================================


# -----------------------------------------------------------------------------
# SENTIMENT SOURCE WEIGHTS  (NON-SECRET operational config)
# -----------------------------------------------------------------------------
# Weighted contribution of each sentiment source to the aggregated score.
# Unavailable sources are dropped and the remaining weights are renormalized,
# so these do not have to sum to exactly 1.0 -- but by default they do.
SENTIMENT_WEIGHT_REDDIT=0.30
SENTIMENT_WEIGHT_CRYPTOCV=0.25
SENTIMENT_WEIGHT_COINGECKO=0.20
SENTIMENT_WEIGHT_LUNARCRUSH=0.10
SENTIMENT_WEIGHT_TRENDS=0.08
SENTIMENT_WEIGHT_FEAR_GREED=0.07


# -----------------------------------------------------------------------------
# SECRETS -- managed by DOPPLER in staging/prod.
# -----------------------------------------------------------------------------
# The values below are PLACEHOLDERS for local development only. Do NOT commit
# real values. In deployed environments these come from Doppler, not this file.
# See doppler.env.example for the authoritative list of required Doppler secrets.

# CoinGecko paid Basic tier API key (used by the CoinGecko sentiment source).
COINGECKO_API_KEY=

# LunarCrush free hobby tier API key (galaxy score / alt rank market data).
LUNARCRUSH_API_KEY=

# Reddit OAuth app credentials.
# REDDIT_USER_AGENT MUST follow: platform:app_id:version (by /u/username)
# e.g. python:scalpbot:1.0 (by /u/your_username)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
