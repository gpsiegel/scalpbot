# =============================================================================
# scalpbot operational config -- NONPROD   (committed, PR-controlled, NO secrets)
# =============================================================================
# This file is the source of truth for NON-SECRET operational config in the
# nonprod environment. Flip an avenue on/off or change risk here and open a PR:
# the change is reviewed and shipped like any other code change.
#
# RULES:
#   * NEVER put secrets here (API keys, DB creds, tokens). Those live in Doppler.
#   * These values are applied as DEFAULTS at startup; a real environment
#     variable (Doppler / CI / shell) with the same name always wins.
#
# SAFETY: nonprod is ALWAYS paper. The three guards below can NEVER make it
# trade live -- live trading additionally requires APP_ENV=prod (see config.py
# is_live()). Any non-prod APP_ENV is forced to paper regardless of these flags.
# =============================================================================

APP_ENV=nonprod
PAPER_TRADING=true
LIVE_TRADING=false

# --- Avenue on/off switches (flip via PR) ------------------------------------
ENABLE_CRYPTO=true
ENABLE_STOCKS=true
ENABLE_OPTIONS=true

# --- Risk / behaviour --------------------------------------------------------
RISK_TIER=moderate
RESPECT_MARKET_HOURS=true
ALLOW_SHORT=true

# --- Position caps -----------------------------------------------------------
MAX_TOTAL_POSITIONS=3
MAX_CRYPTO_POSITIONS=2
MAX_STOCK_POSITIONS=2
MAX_OPTION_POSITIONS=2
