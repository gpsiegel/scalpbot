# =============================================================================
# scalpbot operational config -- PROD   (committed, PR-controlled, NO secrets)
# =============================================================================
# This file is the source of truth for NON-SECRET operational config in the
# prod environment. Flip an avenue on/off or change risk here and open a PR.
#
# RULES:
#   * NEVER put secrets here (API keys, DB creds, tokens). Those live in Doppler.
#   * These values are applied as DEFAULTS at startup; a real environment
#     variable (Doppler / CI / shell) with the same name always wins.
#
# SAFETY: prod is the ONLY environment permitted to touch the LIVE Alpaca
# account. Even so, it runs through PAPER methods UNLESS all three guards below
# are flipped to go live:
#       APP_ENV=prod  AND  PAPER_TRADING=false  AND  LIVE_TRADING=true
# With the defaults below (paper=true, live=false) prod trades on the paper
# endpoint. Going live is therefore an explicit, reviewable PR to this file.
# =============================================================================

APP_ENV=prod
PAPER_TRADING=true
LIVE_TRADING=false

# --- Avenue on/off switches (flip via PR) ------------------------------------
# Stocks/options are OFF: every sentiment source but Fear & Greed only
# resolves crypto tickers (sentiment/base.py COIN_METADATA), so stocks/options
# would trade purely on the crypto-wide Fear & Greed index. Re-enable once an
# equity-capable sentiment source lands (see sentiment.base.EQUITY_CAPABLE_SOURCES).
ENABLE_CRYPTO=true
ENABLE_STOCKS=false
ENABLE_OPTIONS=false

# --- Risk / behaviour --------------------------------------------------------
RISK_TIER=moderate
RESPECT_MARKET_HOURS=true
ALLOW_SHORT=true

# --- Position caps -----------------------------------------------------------
MAX_TOTAL_POSITIONS=3
MAX_CRYPTO_POSITIONS=2
MAX_STOCK_POSITIONS=2
MAX_OPTION_POSITIONS=2
